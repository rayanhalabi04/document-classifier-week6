# Copy this file to .env and fill in values before running locally.
# Never commit .env to Git.

# --- Database ---
DATABASE_URL=postgresql://docuser:docpass@localhost:5432/docclassifier

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_OVERLAYS=overlays

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Vault ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# --- SFTP ---
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USERNAME=user
SFTP_PASSWORD=pass
SFTP_DROP_DIR=/upload

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console
