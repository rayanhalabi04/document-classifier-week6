# Copy this file to backend/.env before running locally.
# Never commit backend/.env to Git.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=document_classifier
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/document_classifier

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_OVERLAYS=overlays

# --- Vault ---
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# --- SFTP ---
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USERNAME=vendor
SFTP_USER=vendor
SFTP_PASSWORD=vendorpass
SFTP_DROP_DIR=drop

# --- JWT ---
JWT_SECRET=change-me-in-production
# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Admin Seed ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin
